+        verses = {k: " ".join("".join(v).split()) for k, v in p.out.items() if "".join(v).strip()}
+    if verses:
+        if len(_CHAPTER_CACHE) > 64:
+            _CHAPTER_CACHE.clear()
+        _CHAPTER_CACHE[key] = verses
+    return verses
